; Engine configuration file.
; Projeto de TCC — RPG 2D com PCG e Coerência Semântica.
; Gerado manualmente; o Godot 4 completa os campos ao abrir o projeto.

config_version=5

[application]

config/name="RPG PCG - Coerencia Semantica"
config/description="Geracao Procedural de Conteudo com atributos correlacionados por probabilidade condicionada. TCC - Gabriel Wendorff."
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
